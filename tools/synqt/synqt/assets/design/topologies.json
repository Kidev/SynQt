{
  "_": [
    "SPDX-FileCopyrightText: 2026 Alexandre 'kidev' Poumaroux",
    "SPDX-License-Identifier: Apache-2.0",
    "",
    "One topology per rule the editor paints, each the smallest project that breaks it.",
    "Read by both validators: the browser's rules.js must produce the named rule, and",
    "`synqt check` must reach the same verdict at the same level. A rule the page knows",
    "and the command line does not would teach somebody that the editor is the authority,",
    "and it is not: the build reads synqt.yaml.",
    "",
    "'why' is what the rule is for, in the words the page shows. Keep it a sentence."
  ],
  "cases": [
    {
      "id": "client-reaches-the-database",
      "rule": "client-consumes-non-edge",
      "level": "error",
      "why": "The browser holds no mesh certificate and cannot route to the mesh, so a client can only consume a connect point owned by a web edge.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "client",
            "type": "client"
          },
          {
            "name": "web",
            "type": "web_edge"
          },
          {
            "name": "database",
            "type": "relational"
          }
        ],
        "links": [
          {
            "name": "database",
            "contract": "DatabaseContract",
            "owner": "database",
            "consumers": [
              "web",
              "client"
            ]
          }
        ]
      }
    },
    {
      "id": "owner-that-is-not-there",
      "rule": "unknown-owner",
      "level": "error",
      "why": "Nothing would host this connect point: the entity named as its owner is not in the project.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "client",
            "type": "client"
          },
          {
            "name": "web",
            "type": "web_edge"
          }
        ],
        "links": [
          {
            "name": "records",
            "contract": "RecordsContract",
            "owner": "records",
            "consumers": [
              "web"
            ]
          }
        ]
      }
    },
    {
      "id": "consumer-that-is-not-there",
      "rule": "unknown-consumer",
      "level": "error",
      "why": "The consumer list is the authorization, and a name that matches no entity is usually one that was meant to match something.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "client",
            "type": "client"
          },
          {
            "name": "web",
            "type": "web_edge"
          }
        ],
        "links": [
          {
            "name": "web",
            "contract": "WebContract",
            "owner": "web",
            "consumers": [
              "reports"
            ]
          }
        ]
      }
    },
    {
      "id": "owner-listed-among-its-consumers",
      "rule": "owner-is-its-own-consumer",
      "level": "error",
      "why": "The owner holds the Source. It does not open a link to itself to acquire a replica of what it already has, and listing it only makes the consumer list look wider than it is.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "client",
            "type": "client"
          },
          {
            "name": "web",
            "type": "web_edge"
          }
        ],
        "links": [
          {
            "name": "web",
            "contract": "WebContract",
            "owner": "web",
            "consumers": [
              "web"
            ]
          }
        ]
      }
    },
    {
      "id": "two-entities-one-name",
      "rule": "duplicate-entity-name",
      "level": "error",
      "why": "Entities are keyed by name, so the second declaration replaces the first rather than colliding with it. Half the file would describe an entity that is never built.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "client",
            "type": "client"
          },
          {
            "name": "web",
            "type": "web_edge"
          },
          {
            "name": "web",
            "type": "jobs"
          }
        ],
        "links": []
      }
    },
    {
      "id": "one-entity-two-connect-points",
      "rule": "duplicate-link-owner",
      "level": "error",
      "why": "An entity has one connect point, so the second silently takes over the first, consumer list and export block together. A narrower consumer list can disappear this way.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "client",
            "type": "client"
          },
          {
            "name": "web",
            "type": "web_edge"
          },
          {
            "name": "database",
            "type": "relational"
          }
        ],
        "links": [
          {
            "name": "web",
            "contract": "WebContract",
            "owner": "web",
            "consumers": [
              "web"
            ]
          },
          {
            "name": "web",
            "contract": "WebContract",
            "owner": "web",
            "consumers": [
              "client"
            ]
          }
        ]
      }
    },
    {
      "id": "shared-written-on-a-client",
      "rule": "shared-on-a-client",
      "level": "error",
      "why": "A client is one browser and shares with nobody, so the word says nothing there and reads like a setting that works.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "client",
            "type": "client",
            "shared": true
          },
          {
            "name": "web",
            "type": "web_edge"
          }
        ],
        "links": [
          {
            "name": "web",
            "contract": "WebContract",
            "owner": "web",
            "consumers": [
              "client"
            ]
          }
        ]
      }
    },
    {
      "id": "client-with-nothing-to-connect-to",
      "rule": "no-web-edge-for-client",
      "level": "error",
      "why": "A client connects out to a web edge and to nothing else. Without one in the project there is no address for it to open, so it is a client that cannot run.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "client",
            "type": "client"
          },
          {
            "name": "database",
            "type": "relational"
          }
        ],
        "links": []
      }
    },
    {
      "id": "link-on-a-local-socket",
      "rule": "local-transport-declared",
      "level": "warn",
      "why": "A local socket is a legitimate same-host fast path, but the operating system identifies the connecting user, not the entity, so any process running as that user can present any entity name.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "client",
            "type": "client"
          },
          {
            "name": "web",
            "type": "web_edge"
          },
          {
            "name": "database",
            "type": "relational"
          }
        ],
        "links": [
          {
            "name": "database",
            "contract": "DatabaseContract",
            "owner": "database",
            "consumers": [
              "web"
            ],
            "transport": "local"
          }
        ]
      }
    },
    {
      "id": "the-client-owns-a-connect-point",
      "rule": "client-owns-connect-point",
      "level": "error",
      "why": "An owner listens for consumers to acquire its Source, and a browser cannot listen: there is no WebSocket server under WebAssembly, so the client is always the one that connects out.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "client",
            "type": "client"
          },
          {
            "name": "web",
            "type": "web_edge"
          }
        ],
        "links": [
          {
            "name": "client",
            "contract": "ClientContract",
            "owner": "client",
            "consumers": [
              "web"
            ]
          }
        ]
      }
    },
    {
      "id": "an-entity-nothing-reaches",
      "rule": "orphan-entity",
      "level": "warn",
      "why": "An entity that owns no connect point and consumes none is a process that starts, talks to nobody, and is never noticed again.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "app",
            "type": "client"
          },
          {
            "name": "edge",
            "type": "web_edge"
          },
          {
            "name": "rollups",
            "type": "jobs"
          }
        ],
        "links": [
          {
            "name": "edge",
            "contract": "EdgeContract",
            "owner": "edge",
            "consumers": [
              "app"
            ]
          }
        ]
      }
    },
    {
      "id": "a-mesh-member-gated-on-a-scope",
      "rule": "member-scope-without-a-browser",
      "level": "error",
      "why": "A scope belongs to a user's session and a calling entity has none, so a gate on a point no client consumes refuses every caller that could reach it.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "web",
            "type": "web_edge"
          },
          {
            "name": "database",
            "type": "relational"
          }
        ],
        "links": [
          {
            "name": "database",
            "owner": "database",
            "consumers": [
              "web"
            ],
            "members": [
              {
                "kind": "slot",
                "name": "purge",
                "type": "",
                "scope": "admin",
                "params": [],
                "roles": []
              }
            ]
          }
        ]
      }
    }
  ]
}
