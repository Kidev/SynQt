    "",
    "One topology per rule the editor paints, each the smallest project that breaks it.",
    "Read by both validators: the browser's rules.js must produce the named rule, and",
    "`synqt check` must reach the same verdict at the same level. A rule the page knows",
    "and the command line does not would teach somebody that the editor is the authority,",
    "and it is not: the build reads synqt.yaml.",
    "",
    "'why' is what the rule is for, in the words the page shows. Keep it a sentence."
  ],
  "cases": [
    {
      "id": "client-reaches-the-database",
      "rule": "client-consumes-non-edge",
      "level": "error",
      "why": "The browser holds no mesh certificate and cannot route to the mesh, so a client can only consume a connect point owned by a web edge.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "client",
            "type": "client"
          },
          {
            "name": "web",
            "type": "web_edge"
          },
          {
            "name": "database",
            "type": "relational"
          }
        ],
        "links": [
          {
            "name": "database",
            "contract": "Database",
            "owner": "database",
            "consumers": [
              "web",
              "client"
            ]
          }
        ]
      }
    },
    {
      "id": "owner-that-is-not-there",
      "rule": "unknown-owner",
      "level": "error",
      "why": "Nothing would host this connect point: the entity named as its owner is not in the project.",
