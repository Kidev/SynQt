    },
    {
      "id": "one-entity-two-connect-points",
      "rule": "duplicate-link-owner",
      "level": "error",
      "why": "An entity has one connect point, so the second silently takes over the first, consumer list and export block together. A narrower consumer list can disappear this way.",
