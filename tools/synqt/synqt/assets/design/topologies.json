      "rule": "owner-is-its-own-consumer",
      "level": "error",
      "why": "The owner holds the Source. It does not open a link to itself to acquire a replica of what it already has, and listing it only makes the consumer list look wider than it is.",
      "document": {
        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "client",
            "type": "client"
          },
