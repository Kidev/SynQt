        "version": 1,
        "project": "rules",
        "entities": [
          {
            "name": "client",
            "type": "client"
          },
          {
            "name": "web",
            "type": "web_edge"
          }
        ],
        "links": [
          {
            "name": "records",
            "contract": "Records",
            "owner": "records",
            "consumers": [
              "web"
            ]
          }
        ]
      }
    },
