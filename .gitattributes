# What GitHub counts as this repository's languages.
#
# Only third-party code is vendored. The test suites and the benchmark harnesses
# under tests/ and benchmarks/ are this project's own code and are counted.

tools/docs-hooks/doxygen-awesome/** linguist-vendored
tools/synqt/synqt/assets/design/vendor/** linguist-vendored

# The documentation site: its Markdown, theme overrides, CSS and build hooks.
docs/**                 linguist-documentation
overrides/**            linguist-documentation
deploy/get.synqt.org/** linguist-documentation
tools/docs-hooks/**     linguist-documentation
tools/pygments-synqt/** linguist-documentation

# The `synqt` command is this project's own Python, and nobody writes Python to use
# SynQt, so it is left out of the count without being marked vendored. The contract
# compiler under tools/synqtc stays counted: cmake/SynQtContracts.cmake runs it in
# every build.
tools/synqt/** linguist-detectable=false

# A bare .h is ambiguous to GitHub (C, C++ or Objective-C, decided by heuristic on
# the contents). Every header here is C++, so say so rather than let the answer
# depend on which files happen to name a class.
*.h linguist-language=C++
