// Two contracts that are nothing but published models, for the tests that ask what
// crosses one and what a consumer can do to it.

// Watched over a real connection. What a consumer's write reaches.
contract Rows {
    model rows(string id, string text)
}

// Driven locally. What the owner's own publish is allowed to put on the wire. Every
// role kind is here, `var` included, because `var` is the one that checks nothing.
contract Checked {
    model rows(string id, int n, var payload)
}

// The types that take a bound, one of each, so that what the generator emits is compiled
// and run rather than only inspected. Each is measured the way its kind of value is:
// characters for text and a URL, elements for a list, serialized bytes for a var. `date`
// carries no bound and is here to prove the rep pulls in the header its type needs.
contract Bounded {
    prop string[8] label
    prop url[24] home
    prop list[3] recent
    prop date opened
    model rows(string[4] code, var[64] blob)
    signal refused(string[6] reason)
}
